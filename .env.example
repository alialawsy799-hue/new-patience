# ---------------------------------------------------------------------------
# PATIENCE — environment configuration
# Copy to `.env.local` for development, and set the same keys in your host
# (Vercel / Fly / Railway ...) for production. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Public origin of the deployment. Used for canonical URLs, sitemap, Open Graph
# and for the strict same-origin check performed on every mutating API request.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database --------------------------------------------------------------
# "postgres" -> real PostgreSQL server (required in production)
# "pglite"   -> embedded PostgreSQL (WASM) stored on disk, for local dev only
DATABASE_DRIVER="pglite"
DATABASE_URL="postgresql://user:password@localhost:5432/patience"
# Only used when DATABASE_DRIVER=pglite
PGLITE_DATA_DIR="./.data/patience-db"

# --- Secrets ---------------------------------------------------------------
# Generate each one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Signs the http-only student/admin session cookies (HMAC-SHA256).
SESSION_SECRET="replace-me-with-32-random-bytes-base64"
# Server-side pepper mixed into the activation-code lookup hash.
# Changing this invalidates every existing activation code. Treat as permanent.
CODE_HASH_PEPPER="replace-me-with-32-random-bytes-base64"
# AES-256-GCM key protecting activation codes at rest so admins can re-export
# them later. Must decode to exactly 32 bytes.
CODE_ENCRYPTION_KEY="replace-me-with-32-random-bytes-base64"

# --- Sessions --------------------------------------------------------------
# Lifetime of a student session in days.
STUDENT_SESSION_DAYS="90"
# Lifetime of an admin session in hours (kept deliberately short).
ADMIN_SESSION_HOURS="8"

# --- Bootstrap admin (only read by `npm run db:seed`) ----------------------
SEED_ADMIN_EMAIL="admin@patience.academy"
SEED_ADMIN_PASSWORD="ChangeMe!Patience2025"
SEED_ADMIN_NAME="PATIENCE Administrator"
SEED_STAFF_EMAIL="staff@patience.academy"
SEED_STAFF_PASSWORD="PatienceStaff2025!"
SEED_STAFF_NAME="موظفة المتجر"

# --- Vimeo -----------------------------------------------------------------
# Server-side only. Never prefixed with NEXT_PUBLIC_. Optional: used to read
# video metadata (duration, thumbnail, privacy settings) from the Vimeo API.
VIMEO_ACCESS_TOKEN=""
# Domain that Vimeo videos are whitelisted for ("Specific domains" privacy).
# The player is rendered with this as the referrer policy target.
VIMEO_ALLOWED_DOMAIN="localhost"

# --- Telegram orders bot ---------------------------------------------------
# Create a bot named "الطلبات" with @BotFather, then paste the token and the
# chat/group id that should receive new store orders. Can also be set from
# Admin → Settings. Leave blank to skip notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ORDERS_CHAT_ID=""

# --- Rate limiting ---------------------------------------------------------
# Failed activation attempts allowed per IP per window before a temporary lock.
ACTIVATION_MAX_ATTEMPTS="8"
ACTIVATION_WINDOW_MINUTES="15"
ADMIN_LOGIN_MAX_ATTEMPTS="5"
ADMIN_LOGIN_WINDOW_MINUTES="15"
